# Copy to ".env" (gitignored) at the repo root and fill in the real values.
# Used by docker-compose.prod.yml — the things that differ between a local
# checkout and the production deploy on astralex.dev.
DND_DB_PASSWORD=
DND_CORS_ORIGIN=https://dnd.astralex.dev

# Discord OAuth app (developer portal) — redirect URI must be set there to
# https://dnd-api.astralex.dev/api/auth/discord/callback.
DND_DISCORD_CLIENT_ID=
DND_DISCORD_CLIENT_SECRET=
