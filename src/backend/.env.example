# Copy to ".env" in this folder (gitignored) for local Docker development.
# docker compose reads it automatically.

# Your Discord OAuth app (developer portal → OAuth2). Its redirect list must
# include http://localhost:5001/api/auth/discord/callback.
DND_DISCORD_CLIENT_ID=
DND_DISCORD_CLIENT_SECRET=

# Your own Discord user ID, so you're the DM locally
# (Discord → Settings → Advanced → Developer Mode, right-click yourself → Copy User ID).
DND_DM_DISCORD_ID=
